# Copy to backend/.env and fill in GNANI_API_KEY. Never commit the real file.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_DEFAULT_MODEL=timbre-v3.0
GNANI_DEFAULT_VOICE=Lakshmi
GNANI_LANGUAGE=en-IN
GNANI_SPEED=1.0
GNANI_TIMEOUT_SECONDS=60
SCRIPT_WARN_CHARS=800
SCRIPT_BLOCK_CHARS=2000
DATA_DIR=./data
# Streamlit calls this API from Python (server side), so no browser origin is
# needed. Add one only if a browser client is ever built.
CORS_ORIGINS=
